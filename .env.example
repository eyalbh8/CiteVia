# Set to the confirmed public origin before a production build.
SITE_URL=https://citevia.io
# Enable only on the public production deployment. Previews stay noindex.
SITE_INDEXABLE=false
CONTACT_EMAIL=eyal@citevia.com
# Optional HTTPS booking URL. Otherwise the CTA leads to /private-ai-visibility-assessment.
BOOKING_URL=
# Optional HTTPS endpoint accepting the JSON contract in docs/OPERATIONS.md.
# Without this, the form explicitly prepares an email for the visitor to send.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_TOKEN=
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
