{
  "name": "citevia-site",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-styles.mjs && next build",
    "build:amplify": "node scripts/build-amplify.mjs",
    "start": "next start",
    "typecheck": "node scripts/build-styles.mjs && next typegen && tsc --noEmit",
    "test": "node --test scripts/*.test.mjs",
    "check:seo": "node scripts/check-seo.mjs",
    "format": "prettier --write src scripts docs README.md BRIEF.md next.config.ts tsconfig.json package.json .github/workflows/site-checks.yml"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lightningcss": "1.33.0",
    "postcss": "8.5.23",
    "prettier": "3.9.10",
    "typescript": "^5.9.0"
  }
}
